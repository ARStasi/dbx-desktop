<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="dbx-desktop"
        Arguments=""
        InstallLocation="C:\Program Files\dbx-desktop\dbx-desktop">
    </Installer>
    <PackageInformation
        PackageName="dbx-desktop"
        PackageDisplayName="dbx-desktop"
        PublisherName="CN=dbx-desktop"
        PublisherDisplayName="dbx-desktop"
        Version="0.1.0.0"
        PackageDescription="A desktop companion for Databricks">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="dev.dbxdesktop.app"
                Description="A desktop companion for Databricks"
                DisplayName="dbx-desktop"
                ExecutableName="dbx-desktop"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>dbx-desktop</DisplayName>
            <PublisherDisplayName>dbx-desktop</PublisherDisplayName>
            <Description>A desktop companion for Databricks</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="dbx-desktop.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
